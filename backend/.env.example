# ══ bidqa 配置模板（docs/01 §5 配置三列表的落地）══
# 复制为 backend/.env 后按需填写；优先级：真实环境变量 > 本文件 > 内置默认值。
# 规则：核心槽位缺失 = 启动失败；能力槽位缺失 = 对应能力降级（health 如实显示）。

# ── 核心槽位（缺失=启动失败）──
# 主模型：任意 OpenAI-compatible 端点自填（DeepSeek/GLM/Qwen/SenseNova 等均可），无预置厂商枚举
# 注意：CHAT_API_KEY 占位值仅让服务可启动（M0 脚手架验收）；M1 起必须换成真实 key
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=sk-REPLACE-ME
CHAT_MODEL=deepseek-chat

# 向量库：本地绿色服务（deploy/download-services.sh 安装）
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ── 主模型扩展（能力型）──
# 深度思考：留空 = 回退提示词注入
CHAT_THINKING_MODEL=
# 主槽位可选多组命名 profile（A12 前端切换器）：逗号分隔，如 fast,cheap
# 每组配套三件套环境变量：CHAT_<NAME>_BASE_URL / CHAT_<NAME>_API_KEY / CHAT_<NAME>_MODEL
CHAT_PROFILES=
# 主槽位输出预算：思考型上游先烧 reasoning 再出正文，预算不足时正文为空（finish=length）
# 留空 = 不传（用上游默认）；建议思考型模型设 8192
CHAT_MAX_TOKENS=

# ── 视觉槽位（能力型；缺失 = 图片解析降级）──
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ── OCR 槽位（能力型；缺失 = 自动路由退化为 Qwen 通用描述）──
# v2.3 双通道：文档/表格类图片走此槽位按高分辨率原件提取文字（建议 PaddlePaddle/PaddleOCR-VL 系列）
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# ── 判分槽位（能力型；缺失 = 评测不可用）──
# 异源校验：与主槽位「端点+凭据+模型」指纹完全相同 → 拒绝跑批（5032）；仅同端点 → 告警
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# ── 嵌入/重排（能力型；嵌入缺失 = 降级本地 jieba BM25 灾备通道 sparse_bm25）──
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 数据服务（绿色安装，能力型）──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bidqa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── 联网检索（能力型；WEB_SEARCH_PROVIDERS 留空=联网关闭，前端不显示联网按钮）──
# 逗号分隔可多个：tavily / exa；列名的供应商须对应 key 已配才生效，配置序即合并序
WEB_SEARCH_PROVIDERS=tavily
TAVILY_API_KEY=
EXA_API_KEY=

# ── PDF 解析（能力型；缺失 = pdfplumber 本地兜底）──
MINERU_API_KEY=

# ── 数据加工批量通道（能力型；缺失 = subject-batch run 不可用，build/fetch 不受影响）──
# 国际版 z.ai（https://z.ai）API key；免费档 GLM-4.7-Flash。国际版无 Batch API，走同步并发
SUBJECT_BATCH_API_KEY=
SUBJECT_BATCH_BASE_URL=https://api.z.ai/api/paas/v4
SUBJECT_BATCH_MODEL=glm-4.7-flash

# ── 鉴权与 CORS ──
# API_AUTH_TOKEN = 机器主 token（脚本/e2e 免登录用，语义=管理员级；不经过用户体系）
# 用户体系开启时，除 /api/health 与 /api/auth/* 引导端点外全部要求 Bearer 会话令牌
API_AUTH_TOKEN=
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 用户体系（三角色 admin/user/guest；USERS_ENABLED=false 退回纯 token 单机模式）──
USERS_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123            # ⚠ 公开默认值，仅限纯本机开发；任何非本机场景必须改本行（首次种子用）并对账号跑 `uv run bidqa user reset admin --password <新口令>`（改本行不会动已存在账号）
SESSION_TTL_HOURS=72               # 登录会话有效期（小时）
GUEST_RATE_LIMIT=10                # 游客独立限流（次/60s；普通用户 30/60s 不变）

# ── 在线评测（能力型；行为指标全量免费，质量分采样默认 0，点踩 100% 必评忠实度单维）──
ONLINE_EVAL_ENABLED=false
ONLINE_EVAL_SAMPLE_RATE=0
